<UserControl
    x:Class="PlainCommander.App.Views.FilePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlainCommander.Presentation"
    xmlns:ui="using:PlainCommander.App.Helpers">
  <UserControl.Resources>
    <!-- The cursor row (the list's selection) has no grey fill, only the accent bar on its left edge (and the focus frame
         while the panel has the keyboard), so it cannot be mistaken for a marked file, which has its own colour. -->
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0F808080" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#14808080" />
    <!-- Column widths shared by the header and the rows. Resizable columns come with the settings dialog. -->
    <GridLength x:Key="ColIcon">20</GridLength>
    <GridLength x:Key="ColExt">56</GridLength>
    <GridLength x:Key="ColSize">92</GridLength>
    <GridLength x:Key="ColDate">116</GridLength>
    <GridLength x:Key="ColAttr">74</GridLength>
    <GridLength x:Key="ColDateShort">80</GridLength>

    <DataTemplate x:Key="FullTemplate" x:DataType="vm:FileItem">
      <Grid Padding="6,0,8,0" CornerRadius="4" ColumnSpacing="6"
            Background="{x:Bind ui:Ui.MarkBackground(IsMarked), Mode=OneWay}" Opacity="{x:Bind ui:Ui.RowOpacity(IsHidden)}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource ColIcon}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource ColExt}" />
          <ColumnDefinition Width="{StaticResource ColSize}" />
          <ColumnDefinition Width="{StaticResource ColDate}" />
          <ColumnDefinition Width="{x:Bind ui:Ui.DetailWidth(DetailKind), Mode=OneWay}" />
          <ColumnDefinition Width="{StaticResource ColAttr}" />
        </Grid.ColumnDefinitions>
        <!-- Mark: a check badge on the icon corner, clear of the cursor pill on the row's left edge -->
        <Grid Width="20" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind ui:Ui.Image(Icon), Mode=OneWay}" />
          <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind ui:Ui.MarkDot(IsMarked), Mode=OneWay}">
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource PcCardBrush}" StrokeThickness="1" />
            <FontIcon Glyph="&#xE73E;" FontSize="7" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Grid>
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" Foreground="{x:Bind ui:Ui.NameForeground(IsDirectory, IsMarked, IsEncrypted), Mode=OneWay}" FontWeight="{x:Bind ui:Ui.RowWeight(IsDirectory, IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{x:Bind Extension}" Foreground="{x:Bind ui:Ui.MarkForeground(IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{x:Bind ui:Ui.SizeForeground(IsDirectory, IsMarked), Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{x:Bind DateText}" Foreground="{ThemeResource PcTextMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{x:Bind DetailText, Mode=OneWay}" Foreground="{ThemeResource PcTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="6" Text="{x:Bind AttributesText}" Foreground="{ThemeResource PcTextMutedBrush}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Narrow panels drop the attribute column so the name keeps some room. -->
    <DataTemplate x:Key="FullNarrowTemplate" x:DataType="vm:FileItem">
      <Grid Padding="6,0,8,0" CornerRadius="4" ColumnSpacing="6"
            Background="{x:Bind ui:Ui.MarkBackground(IsMarked), Mode=OneWay}" Opacity="{x:Bind ui:Ui.RowOpacity(IsHidden)}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource ColIcon}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource ColExt}" />
          <ColumnDefinition Width="{StaticResource ColSize}" />
          <ColumnDefinition Width="{StaticResource ColDate}" />
          <ColumnDefinition Width="{x:Bind ui:Ui.DetailWidth(DetailKind), Mode=OneWay}" />
        </Grid.ColumnDefinitions>
        <!-- Mark: a check badge on the icon corner, clear of the cursor pill on the row's left edge -->
        <Grid Width="20" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind ui:Ui.Image(Icon), Mode=OneWay}" />
          <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind ui:Ui.MarkDot(IsMarked), Mode=OneWay}">
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource PcCardBrush}" StrokeThickness="1" />
            <FontIcon Glyph="&#xE73E;" FontSize="7" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Grid>
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" Foreground="{x:Bind ui:Ui.NameForeground(IsDirectory, IsMarked, IsEncrypted), Mode=OneWay}" FontWeight="{x:Bind ui:Ui.RowWeight(IsDirectory, IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{x:Bind Extension}" Foreground="{x:Bind ui:Ui.MarkForeground(IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{x:Bind ui:Ui.SizeForeground(IsDirectory, IsMarked), Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{x:Bind DateText}" Foreground="{ThemeResource PcTextMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{x:Bind DetailText, Mode=OneWay}" Foreground="{ThemeResource PcTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Narrow panels with attributes: the extension stays in the name and the date loses its time. -->
    <DataTemplate x:Key="FullNarrowAttrTemplate" x:DataType="vm:FileItem">
      <Grid Padding="6,0,8,0" CornerRadius="4" ColumnSpacing="6"
            Background="{x:Bind ui:Ui.MarkBackground(IsMarked), Mode=OneWay}" Opacity="{x:Bind ui:Ui.RowOpacity(IsHidden)}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource ColIcon}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource ColSize}" />
          <ColumnDefinition Width="{StaticResource ColDateShort}" />
          <ColumnDefinition Width="{x:Bind ui:Ui.DetailWidth(DetailKind), Mode=OneWay}" />
          <ColumnDefinition Width="{StaticResource ColAttr}" />
        </Grid.ColumnDefinitions>
        <!-- Mark: a check badge on the icon corner, clear of the cursor pill on the row's left edge -->
        <Grid Width="20" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind ui:Ui.Image(Icon), Mode=OneWay}" />
          <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind ui:Ui.MarkDot(IsMarked), Mode=OneWay}">
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource PcCardBrush}" StrokeThickness="1" />
            <FontIcon Glyph="&#xE73E;" FontSize="7" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Grid>
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{x:Bind ui:Ui.NameForeground(IsDirectory, IsMarked, IsEncrypted), Mode=OneWay}" FontWeight="{x:Bind ui:Ui.RowWeight(IsDirectory, IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{x:Bind ui:Ui.SizeForeground(IsDirectory, IsMarked), Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{x:Bind ShortDateText}" Foreground="{ThemeResource PcTextMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{x:Bind DetailText, Mode=OneWay}" Foreground="{ThemeResource PcTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{x:Bind AttributesText}" Foreground="{ThemeResource PcTextMutedBrush}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Narrow panels with the detail column and no attributes: the extension stays in the name, the date loses its time. -->
    <DataTemplate x:Key="FullNarrowDetailTemplate" x:DataType="vm:FileItem">
      <Grid Padding="6,0,8,0" CornerRadius="4" ColumnSpacing="6"
            Background="{x:Bind ui:Ui.MarkBackground(IsMarked), Mode=OneWay}" Opacity="{x:Bind ui:Ui.RowOpacity(IsHidden)}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource ColIcon}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource ColSize}" />
          <ColumnDefinition Width="{StaticResource ColDateShort}" />
          <ColumnDefinition Width="{x:Bind ui:Ui.DetailWidth(DetailKind), Mode=OneWay}" />
        </Grid.ColumnDefinitions>
        <!-- Mark: a check badge on the icon corner, clear of the cursor pill on the row's left edge -->
        <Grid Width="20" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind ui:Ui.Image(Icon), Mode=OneWay}" />
          <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind ui:Ui.MarkDot(IsMarked), Mode=OneWay}">
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource PcCardBrush}" StrokeThickness="1" />
            <FontIcon Glyph="&#xE73E;" FontSize="7" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Grid>
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{x:Bind ui:Ui.NameForeground(IsDirectory, IsMarked, IsEncrypted), Mode=OneWay}" FontWeight="{x:Bind ui:Ui.RowWeight(IsDirectory, IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{x:Bind ui:Ui.SizeForeground(IsDirectory, IsMarked), Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{x:Bind ShortDateText}" Foreground="{ThemeResource PcTextMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{x:Bind DetailText, Mode=OneWay}" Foreground="{ThemeResource PcTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BriefTemplate" x:DataType="vm:FileItem">
      <Grid Width="210" Padding="6,0,8,0" CornerRadius="4" ColumnSpacing="6"
            Background="{x:Bind ui:Ui.MarkBackground(IsMarked), Mode=OneWay}" Opacity="{x:Bind ui:Ui.RowOpacity(IsHidden)}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource ColIcon}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Mark: a check badge on the icon corner, clear of the cursor pill on the row's left edge -->
        <Grid Width="20" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind ui:Ui.Image(Icon), Mode=OneWay}" />
          <Grid Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind ui:Ui.MarkDot(IsMarked), Mode=OneWay}">
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource PcCardBrush}" StrokeThickness="1" />
            <FontIcon Glyph="&#xE73E;" FontSize="7" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Grid>
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{x:Bind ui:Ui.NameForeground(IsDirectory, IsMarked, IsEncrypted), Mode=OneWay}" FontWeight="{x:Bind ui:Ui.RowWeight(IsDirectory, IsMarked), Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="FullPanel">
      <ItemsStackPanel />
    </ItemsPanelTemplate>

    <!-- Brief view: names flow top-to-bottom, then into the next column; the list scrolls sideways. -->
    <ItemsPanelTemplate x:Key="BriefPanel">
      <ItemsWrapGrid Orientation="Vertical" />
    </ItemsPanelTemplate>

    <!-- Row density: the container sets the height, the row template fills it. -->
    <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <!-- the keyboard focus frame of the cursor row in the accent instead of white -->
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PcActiveStrokeBrush}" />
      <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
    </Style>
    <Style x:Key="RowStyleCompact" TargetType="ListViewItem" BasedOn="{StaticResource RowStyle}">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>

    <Style x:Key="ColumnHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{ThemeResource PcTextSecondaryBrush}" />
    </Style>
  </UserControl.Resources>

  <!--
    The panel is a rounded card on the dark stage. The active one gets an accent outline with a soft ring around it;
    the other is faded a little. Inside, top to bottom: tab strip with drive pills, navigation row (up, path, filter),
    column headers, the list and the footer, each on its own shade.
  -->
  <Grid>
  <Border Background="{ThemeResource PcCardBrush}" BorderBrush="{ThemeResource PcStrokeBrush}"
          BorderThickness="1" CornerRadius="12" Opacity="{x:Bind ui:Ui.CardOpacity(ViewModel.IsActive), Mode=OneWay}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Tab strip: the tabs and "+" on the left, one pill per drive on the right -->
    <Grid Grid.Row="0" Padding="6,5,8,0" ColumnSpacing="8" Background="{ThemeResource PcStripBrush}"
          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PcStrokeBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Horizontal" Spacing="2" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:PanelTab">
                <Grid Height="28" Padding="10,0,4,0" CornerRadius="6,6,0,0" ColumnSpacing="6" MinWidth="72" MaxWidth="200"
                      Background="{x:Bind ui:Ui.TabBackground(IsActive), Mode=OneWay}" Tapped="OnTabTapped" Tag="{x:Bind}"
                      ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.ColumnSpan="3" Height="2" Margin="-10,0,-4,0" VerticalAlignment="Top" Fill="{x:Bind ui:Ui.TabLine(IsActive), Mode=OneWay}" />
                  <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{x:Bind ui:Ui.TabForeground(IsActive), Mode=OneWay}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             FontWeight="{x:Bind ui:Ui.TabWeight(IsActive), Mode=OneWay}" Foreground="{x:Bind ui:Ui.TabForeground(IsActive), Mode=OneWay}" />
                  <Border Grid.Column="2" Width="20" Height="20" CornerRadius="4" Background="Transparent" Tapped="OnTabCloseTapped" Tag="{x:Bind}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource PcTextMutedBrush}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          <Button Width="26" Height="24" Padding="0" Margin="2,0,0,2" VerticalAlignment="Center" IsTabStop="False"
                  Background="Transparent" BorderThickness="0" x:Uid="Panel_NewTab" Click="OnNewTab">
            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource PcTextMutedBrush}" />
          </Button>
        </StackPanel>
      </ScrollViewer>
      <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,0,4">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" Spacing="4" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:DriveItem">
            <Border Padding="6,1" CornerRadius="4" BorderThickness="1" Tapped="OnDrivePillTapped" Tag="{x:Bind}"
                    Background="{x:Bind ui:Ui.DrivePillBackground(IsCurrent), Mode=OneWay}"
                    BorderBrush="{x:Bind ui:Ui.DrivePillStroke(IsCurrent), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind MenuText}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE753;" FontSize="11" VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.CloudMark(IsCloud)}"
                          Foreground="{x:Bind ui:Ui.DrivePillForeground(IsCurrent), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ui:Ui.DriveLetter(PillText)}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Foreground="{x:Bind ui:Ui.DrivePillForeground(IsCurrent), Mode=OneWay}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </Grid>

    <!-- Navigation: root and parent buttons, the path field (drive button + breadcrumb), the filter box, view and panel menu -->
    <Grid Grid.Row="1" Padding="6,6,6,6" ColumnSpacing="4" Background="{ThemeResource PcNavBrush}"
          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PcStrokeBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Width="28" Height="28" Padding="0" IsTabStop="False" Background="Transparent" BorderThickness="0"
              x:Uid="Panel_Root" Click="OnGoRoot">
        <FontIcon Glyph="&#xE74A;" FontSize="12" Foreground="{ThemeResource PcTextSecondaryBrush}" />
      </Button>
      <Button Grid.Column="1" Width="28" Height="28" Padding="0" IsTabStop="False" Background="Transparent" BorderThickness="0"
              x:Uid="Panel_Up" Click="OnGoUp">
        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="{ThemeResource PcTextSecondaryBrush}" />
      </Button>
      <Border Grid.Column="2" Height="30" CornerRadius="6" BorderThickness="1" Margin="2,0,2,0"
              Background="{ThemeResource PcFieldBrush}" BorderBrush="{ThemeResource PcStrokeStrongBrush}">
        <Grid ColumnSpacing="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DropDownButton x:Name="DriveButton" Grid.Column="0" Height="28" Padding="8,0,4,0" FontSize="12" FontWeight="SemiBold"
                          Background="Transparent" BorderThickness="0" IsTabStop="False" x:Uid="Panel_Drive">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="{x:Bind ui:Ui.PanelGlyph(ViewModel.CurrentDrive, ViewModel.IsRemote), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PcAccentTextBrush}" />
              <TextBlock Text="{x:Bind ViewModel.DriveLabel, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource PcTextBrush}" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout x:Name="DriveFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnDriveFlyoutOpening" />
            </DropDownButton.Flyout>
          </DropDownButton>
          <!-- The path: breadcrumb normally; Ctrl+L or a click beside the crumbs swaps in an editable box with folder suggestions -->
          <Grid Grid.Column="1" Background="Transparent" Tapped="OnPathAreaTapped">
            <BreadcrumbBar x:Name="Crumbs" VerticalAlignment="Center" IsTabStop="False" Margin="2,-4,0,0" FontSize="12.5"
                           ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}" ItemClicked="OnBreadcrumbClicked">
              <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="vm:PathSegment">
                  <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                </DataTemplate>
              </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
            <!-- Search results shown in this panel: their title instead of the path, × goes back to the folder -->
            <Grid x:Name="ResultsBar" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsShowingResults), Mode=OneWay}" ColumnSpacing="6" Margin="4,0,0,0"
                  Background="{ThemeResource PcFieldBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource PcAccentTextBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ResultsTitle, Mode=OneWay}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="2" Width="24" Height="24" Padding="0" IsTabStop="False" Background="Transparent" BorderThickness="0"
                      x:Uid="Panel_CloseResults" Click="OnCloseResults">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
              </Button>
            </Grid>
            <AutoSuggestBox x:Name="PathBox" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12.5" FontFamily="Cascadia Mono, Consolas"
                            TextChanged="OnPathBoxTextChanged" SuggestionChosen="OnPathSuggestionChosen" QuerySubmitted="OnPathSubmitted"
                            LostFocus="OnPathBoxLostFocus" PreviewKeyDown="OnPathBoxKeyDown" x:Uid="Panel_PathBox" />
          </Grid>
        </Grid>
      </Border>
      <!-- Filter as you type: a name fragment or masks (the same filter as Ctrl+S, name part only); Esc clears it -->
      <Grid x:Name="FilterArea" Grid.Column="3" Width="124">
        <TextBox x:Name="FilterBox" Height="30" MinHeight="30" FontSize="12" Padding="26,5,8,0" IsSpellCheckEnabled="False"
                 Background="{ThemeResource PcFieldBrush}" BorderBrush="{ThemeResource PcStrokeStrongBrush}" CornerRadius="6"
                 PlaceholderForeground="{ThemeResource PcTextMutedBrush}"
                 TextChanged="OnFilterBoxTextChanged" PreviewKeyDown="OnFilterBoxKeyDown" x:Uid="Panel_FilterBox" />
        <FontIcon Glyph="&#xE721;" FontSize="11" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                  Foreground="{ThemeResource PcTextMutedBrush}" />
      </Grid>
      <Button Grid.Column="4" Width="28" Height="28" Padding="0" IsTabStop="False" Background="Transparent" BorderThickness="0"
              x:Uid="Panel_View" Click="OnToggleView">
        <FontIcon Glyph="{x:Bind ui:Ui.ViewGlyph(ViewModel.BriefView), Mode=OneWay}" FontSize="13" Foreground="{ThemeResource PcTextSecondaryBrush}" />
      </Button>
      <Button Grid.Column="5" Width="28" Height="28" Padding="0" IsTabStop="False" Background="Transparent" BorderThickness="0" x:Uid="Panel_Menu">
        <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="{ThemeResource PcTextSecondaryBrush}" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem x:Uid="Cmd_NewTab" Click="OnNewTab" />
            <MenuFlyoutItem x:Uid="Cmd_CloseTab" Click="OnCloseTab" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Uid="Show_SortName" Click="OnSortByName" />
            <MenuFlyoutItem x:Uid="Show_SortExt" Click="OnSortByExtension" />
            <MenuFlyoutItem x:Uid="Show_SortSize" Click="OnSortBySize" />
            <MenuFlyoutItem x:Uid="Show_SortDate" Click="OnSortByModified" />
            <MenuFlyoutItem x:Uid="Show_SortCreated" Click="OnSortByCreated" />
            <MenuFlyoutSeparator />
            <ToggleMenuFlyoutItem x:Uid="Show_Hidden" IsChecked="{x:Bind ViewModel.ShowHidden, Mode=OneWay}" Click="OnToggleHidden" />
            <ToggleMenuFlyoutItem x:Uid="Show_Compact" IsChecked="{x:Bind ViewModel.CompactRows, Mode=OneWay}" Click="OnToggleCompact" />
            <ToggleMenuFlyoutItem x:Uid="Show_Attributes" IsChecked="{x:Bind ViewModel.ShowAttributes, Mode=OneWay}" Click="OnToggleAttributes" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Uid="Show_DetailDimensions" Click="OnDetailDimensions" />
            <MenuFlyoutItem x:Uid="Show_DetailTaken" Click="OnDetailTaken" />
            <MenuFlyoutItem x:Uid="Show_DetailDuration" Click="OnDetailDuration" />
            <MenuFlyoutItem x:Uid="Show_DetailVersion" Click="OnDetailVersion" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Column headers (full view); click sorts, click again reverses -->
    <Grid x:Name="ColumnHeader" Grid.Row="2" Padding="12,3,22,3" ColumnSpacing="6" Background="{ThemeResource PcHeaderBrush}"
          BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PcStrokeBrush}"
          Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.BriefView), Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource ColIcon}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{StaticResource ColExt}" />
        <ColumnDefinition Width="{StaticResource ColSize}" />
        <ColumnDefinition Width="{StaticResource ColDate}" />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="{StaticResource ColAttr}" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByName">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock x:Uid="Col_Name" />
          <TextBlock Text="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" Foreground="{ThemeResource PcAccentTextBrush}" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="ExtHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByExtension">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock x:Uid="Col_Ext" />
          <TextBlock Text="{x:Bind ViewModel.ExtensionSortGlyph, Mode=OneWay}" Foreground="{ThemeResource PcAccentTextBrush}" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" HorizontalContentAlignment="Right" Click="OnSortBySize">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" Foreground="{ThemeResource PcAccentTextBrush}" FontSize="10" VerticalAlignment="Center" />
          <TextBlock x:Uid="Col_Size" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByDate">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{x:Bind ViewModel.DateColumnTitle, Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.DateSortGlyph, Mode=OneWay}" Foreground="{ThemeResource PcAccentTextBrush}" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="DetailHeader" Grid.Column="5" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByDetail" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{x:Bind ViewModel.DetailColumnTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind ViewModel.DetailSortGlyph, Mode=OneWay}" Foreground="{ThemeResource PcAccentTextBrush}" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="AttrHeader" Grid.Column="6" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByAttributes">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock x:Uid="Col_Attr" />
          <TextBlock Text="{x:Bind ViewModel.AttributesSortGlyph, Mode=OneWay}" Foreground="{ThemeResource PcAccentTextBrush}" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- The list. ItemsStackPanel / ItemsWrapGrid virtualize, so only visible rows exist. -->
    <!--
      CornerRadius="0.1" works around microsoft-ui-xaml#11225: once the content extent passes about
      2^21 DIPs (~95k rows here) ItemsStackPanel stops clipping rows at the bottom edge, and neither
      Clip nor CanContentRenderOutsideBounds helps. Remove when the bug is fixed.
    -->
    <ListView
        x:Name="List"
        Grid.Row="3"
        Margin="4,2,4,0"
        CornerRadius="0.1"
        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
        ItemTemplate="{StaticResource FullTemplate}"
        ItemsPanel="{StaticResource FullPanel}"
        SelectionMode="Single"
        ItemContainerStyle="{StaticResource RowStyle}"
        IsItemClickEnabled="False"
        FontFamily="{x:Bind ui:Ui.Font(ViewModel.FontFamily), Mode=OneWay}"
        FontSize="{x:Bind ViewModel.FontSize, Mode=OneWay}"
        DoubleTapped="OnDoubleTapped"
        RightTapped="OnRightTapped"
        CanDragItems="True"
        AllowDrop="True"
        DragItemsStarting="OnDragItemsStarting"
        DragItemsCompleted="OnDragItemsCompleted"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnListPreviewKeyDown"
        CharacterReceived="OnCharacterReceived"
        SelectionChanged="OnSelectionChanged">
      <!-- No entrance/reorder animations: a file manager should switch folders instantly. -->
      <ListView.ItemContainerTransitions>
        <TransitionCollection />
      </ListView.ItemContainerTransitions>
    </ListView>

    <!-- Footer: selection / summary on the left, usage bar and free space of the drive on the right -->
    <Grid Grid.Row="4" Padding="12,5,12,6" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource PcStrokeBrush}"
          Background="{ThemeResource PcFooterBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 Foreground="{x:Bind ui:Ui.StatusForeground(ViewModel.HasMarks), Mode=OneWay}" FontWeight="{x:Bind ui:Ui.StatusWeight(ViewModel.HasMarks), Mode=OneWay}"
                 ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}"
                 Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.IsQuickSearchActive), Mode=OneWay}" />
      <ProgressRing Grid.Column="1" Width="14" Height="14" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
      <Border Grid.Column="2" Width="64" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource PcUsageTrackBrush}"
              ToolTipService.ToolTip="{x:Bind ViewModel.DriveSummary, Mode=OneWay}">
        <Rectangle HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                   Width="{x:Bind ui:Ui.UsageWidth(ViewModel.DriveUsedFraction), Mode=OneWay}"
                   Fill="{x:Bind ui:Ui.UsageBrush(ViewModel.DriveUsedFraction), Mode=OneWay}" />
      </Border>
      <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.DriveFreeText, Mode=OneWay}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource PcTextSecondaryBrush}" VerticalAlignment="Center"
                 ToolTipService.ToolTip="{x:Bind ViewModel.DriveSummary, Mode=OneWay}" />
    </Grid>

    <!-- Quick search box in place of the footer text while the user types: it never covers the row under the cursor -->
    <Border Grid.Row="4" Margin="6,2,6,3" Padding="8,1" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
            BorderThickness="1"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.IsQuickSearchActive, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon Glyph="&#xE721;" FontSize="11" />
        <TextBlock Text="{x:Bind ViewModel.QuickSearchSummary, Mode=OneWay}" FontSize="12" />
      </StackPanel>
    </Border>
  </Grid>
  </Border>
  <!-- Active panel: an accent outline and a faint ring outside it. Drawn over the card, never hit-tested. -->
  <Border Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{ThemeResource PcActiveRingBrush}" IsHitTestVisible="False"
          Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
  <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource PcActiveStrokeBrush}" IsHitTestVisible="False"
          Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
  </Grid>
</UserControl>
