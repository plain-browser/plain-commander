<Window
    x:Class="PlainCommander.App.Views.SyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlainCommander.Presentation"
    Title="Plain Commander">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleRow" Grid.Row="0" Height="40" Padding="12,0,0,0" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE895;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0" FontWeight="SemiBold" />
      <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />
      <Grid x:Name="CaptionPadding" Grid.Column="3" Width="0" />
    </Grid>

    <!-- Column headers: the two folders -->
    <Grid Grid.Row="1" Padding="26,2,26,6" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="44" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Uid="Sync_Name" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Left}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 ToolTipService.ToolTip="{x:Bind ViewModel.Left}" />
      <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.Right}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 ToolTipService.ToolTip="{x:Bind ViewModel.Right}" />
      <TextBlock Grid.Column="4" x:Uid="Sync_Difference" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <ListView x:Name="List" Grid.Row="2" Margin="8,0,8,0" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single"
              CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
              PreviewKeyDown="OnListKeyDown" DoubleTapped="OnListDoubleTapped">
      <ListView.ItemContainerTransitions>
        <TransitionCollection />
      </ListView.ItemContainerTransitions>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="MinHeight" Value="28" />
          <Setter Property="Padding" Value="10,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:SyncRow">
          <Grid ColumnSpacing="10" Height="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="44" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Relative}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Relative}" />
            <TextBlock Grid.Column="1" Text="{x:Bind LeftInfo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" Content="{x:Bind ActionGlyph, Mode=OneWay}" Click="OnCycle" Tag="{x:Bind}" IsTabStop="False"
                    Padding="0" Width="40" Height="24" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="3" Text="{x:Bind RightInfo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="4" Text="{x:Bind DifferenceText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Grid Grid.Row="3" Padding="16,8,16,12" ColumnSpacing="8" RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Uid="Sync_Defaults" Click="OnDefaults" />
        <Button x:Uid="Sync_AllRight" Click="OnAllRight" />
        <Button x:Uid="Sync_AllLeft" Click="OnAllLeft" />
        <Button x:Uid="Sync_None" Click="OnNone" />
        <Button x:Name="DiffButton" x:Uid="Sync_ShowDiff" Click="OnShowDiff" />
      </StackPanel>
      <Button Grid.Column="1" x:Uid="Sync_Run" Style="{StaticResource AccentButtonStyle}" MinWidth="140"
              IsEnabled="{x:Bind ViewModel.CanSync, Mode=OneWay}" Click="OnSync" />
      <Button Grid.Column="2" x:Uid="Mr_Close" Click="OnClose" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12.5" />
    </Grid>
  </Grid>
</Window>
