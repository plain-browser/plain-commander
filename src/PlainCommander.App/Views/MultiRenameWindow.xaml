<Window
    x:Class="PlainCommander.App.Views.MultiRenameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlainCommander.Presentation"
    xmlns:ui="using:PlainCommander.App.Helpers"
    Title="Plain Commander">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleRow" Grid.Row="0" Height="40" Padding="12,0,0,0" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE8AC;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0" FontWeight="SemiBold" />
      <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />
      <Grid x:Name="CaptionPadding" Grid.Column="3" Width="0" />
    </Grid>

    <!-- Rules: masks with placeholders, search and replace, case, counter -->
    <Grid Grid.Row="1" Padding="16,4,16,8" ColumnSpacing="10" RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" x:Uid="Mr_Name" VerticalAlignment="Center" />
      <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="NameBox" Text="{x:Bind ViewModel.NameMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Cascadia Mono, Consolas" GotFocus="OnMaskFocus" />
        <DropDownButton Grid.Column="1" x:Uid="Mr_Insert" IsTabStop="False">
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="InsertMenu" Placement="BottomEdgeAlignedRight" />
          </DropDownButton.Flyout>
        </DropDownButton>
      </Grid>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Uid="Mr_Ext" VerticalAlignment="Center" />
      <TextBox x:Name="ExtBox" Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.ExtensionMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               FontFamily="Cascadia Mono, Consolas" GotFocus="OnMaskFocus" />

      <TextBlock Grid.Row="1" x:Uid="Mr_Search" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
      <TextBlock Grid.Row="1" Grid.Column="2" x:Uid="Mr_Replace" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.Replace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />

      <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16">
        <CheckBox x:Uid="Mr_Regex" IsChecked="{x:Bind ViewModel.UseRegex, Mode=TwoWay}" MinWidth="0" />
        <CheckBox x:Uid="Mr_Case" IsChecked="{x:Bind ViewModel.CaseSensitive, Mode=TwoWay}" MinWidth="0" />
        <CheckBox x:Uid="Mr_Translit" IsChecked="{x:Bind ViewModel.Transliterate, Mode=TwoWay}" MinWidth="0" />
      </StackPanel>

      <!-- The number boxes carry headers, so labels and the combo box sit on the bottom line with them -->
      <TextBlock Grid.Row="3" x:Uid="Mr_Letters" VerticalAlignment="Bottom" Margin="0,0,0,6" />
      <ComboBox x:Name="CaseBox" Grid.Row="3" Grid.Column="1" MinWidth="200" VerticalAlignment="Bottom" SelectionChanged="OnCaseChanged" />
      <TextBlock Grid.Row="3" Grid.Column="2" x:Uid="Mr_Counter" VerticalAlignment="Bottom" Margin="0,0,0,6" />
      <Grid Grid.Row="3" Grid.Column="3" ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <NumberBox x:Name="StartBox" x:Uid="Mr_Start" SpinButtonPlacementMode="Compact" ValueChanged="OnCounterChanged" />
        <NumberBox x:Name="StepBox" Grid.Column="1" x:Uid="Mr_Step" SpinButtonPlacementMode="Compact" ValueChanged="OnCounterChanged" />
        <NumberBox x:Name="DigitsBox" Grid.Column="2" x:Uid="Mr_Digits" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="12" ValueChanged="OnCounterChanged" />
      </Grid>
    </Grid>

    <!-- Preview: old name, new name, what is wrong -->
    <ListView Grid.Row="2" Margin="8,0,8,0" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" IsTabStop="False"
              CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <ListView.ItemContainerTransitions>
        <TransitionCollection />
      </ListView.ItemContainerTransitions>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="MinHeight" Value="26" />
          <Setter Property="Padding" Value="10,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:RenameRow">
          <Grid ColumnSpacing="10" Height="26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind OldName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Grid.Column="2" Text="{x:Bind NewName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       FontWeight="{x:Bind ui:Ui.ChangedWeight(Changes)}" />
            <TextBlock Grid.Column="3" Text="{x:Bind ProblemText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Grid Grid.Row="3" Padding="16,8,16,12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
      <Button x:Name="ApplyButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" x:Uid="Mr_Apply" MinWidth="120"
              IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" Click="OnApply" />
      <Button Grid.Column="2" x:Uid="Mr_Undo" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Click="OnUndo" />
      <Button Grid.Column="3" x:Uid="Mr_Close" Click="OnClose" />
    </Grid>
  </Grid>
</Window>
