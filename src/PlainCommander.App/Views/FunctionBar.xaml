<UserControl
    x:Class="PlainCommander.App.Views.FunctionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!--
      Action bar: seven equal keys over the full width. The key name in the accent, the verb beside it;
      hovering lights the key up in a cyan wash. Hover and pressed colours are the button's own resources
      (the same values as PcFKeyHover… in App.xaml).
    -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2606B6D4" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6606B6D4" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3306B6D4" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6606B6D4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2606B6D4" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6606B6D4" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3306B6D4" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6606B6D4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A06B6D4" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8006B6D4" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2606B6D4" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#8006B6D4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="FKey" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource PcFKeyBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PcStrokeBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PcTextBrush}" />
      </Style>
      <Style x:Key="Kbd" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="KbdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource PcAccentTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid ColumnSpacing="4" Padding="8,6,8,8" Background="{ThemeResource PcFKeyBarBrush}"
        BorderThickness="0,1,0,0" BorderBrush="{ThemeResource PcStrokeBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Button Grid.Column="0" Tag="2" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key2" Style="{StaticResource KbdText}" Text="F2" /></Border><TextBlock x:Name="Label2" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
    <Button Grid.Column="1" Tag="3" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key3" Style="{StaticResource KbdText}" Text="F3" /></Border><TextBlock x:Name="Label3" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
    <Button Grid.Column="2" Tag="4" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key4" Style="{StaticResource KbdText}" Text="F4" /></Border><TextBlock x:Name="Label4" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
    <Button Grid.Column="3" Tag="5" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key5" Style="{StaticResource KbdText}" Text="F5" /></Border><TextBlock x:Name="Label5" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
    <Button Grid.Column="4" Tag="6" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key6" Style="{StaticResource KbdText}" Text="F6" /></Border><TextBlock x:Name="Label6" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
    <Button Grid.Column="5" Tag="7" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key7" Style="{StaticResource KbdText}" Text="F7" /></Border><TextBlock x:Name="Label7" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
    <Button Grid.Column="6" Tag="8" Style="{StaticResource FKey}" Click="OnClick">
      <StackPanel Orientation="Horizontal" Spacing="6"><Border Style="{StaticResource Kbd}"><TextBlock x:Name="Key8" Style="{StaticResource KbdText}" Text="F8" /></Border><TextBlock x:Name="Label8" Style="{StaticResource LabelText}" /></StackPanel>
    </Button>
  </Grid>
</UserControl>
