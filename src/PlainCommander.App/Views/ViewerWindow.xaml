<Window
    x:Class="PlainCommander.App.Views.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:PlainCommander.App.Helpers"
    Title="Plain Commander">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title row: file name, view switch, encoding, wrap. Only DragRegion drags the window. -->
    <Grid x:Name="TitleRow" Grid.Row="0" Height="40" Padding="12,0,0,0" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileName}" VerticalAlignment="Center" Margin="4,0,8,0" FontWeight="SemiBold"
                 MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Path}" />
      <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <ToggleButton x:Name="TextMode" Click="OnTextMode" IsChecked="{x:Bind ViewModel.IsText, Mode=OneWay}" Height="28" Padding="10,0" IsTabStop="False">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Uid="Viewer_Text" /><TextBlock Text="1" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="HexMode" Click="OnHexMode" IsChecked="{x:Bind ViewModel.IsHex, Mode=OneWay}" Height="28" Padding="10,0" IsTabStop="False">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Uid="Viewer_Hex" /><TextBlock Text="2" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" /></StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="ImageMode" Click="OnImageMode" IsChecked="{x:Bind ViewModel.IsImage, Mode=OneWay}" Height="28" Padding="10,0" IsTabStop="False"
                      Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.CanShowImage)}">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Uid="Viewer_Image" /><TextBlock Text="3" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" /></StackPanel>
        </ToggleButton>
      </StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0"
                  Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsText), Mode=OneWay}">
        <DropDownButton x:Name="EncodingButton" Height="28" Padding="10,0,6,0" IsTabStop="False" FontSize="12"
                        Content="{x:Bind ui:Ui.EncodingName(ViewModel.Encoding), Mode=OneWay}" x:Uid="Viewer_Encoding">
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="EncodingFlyout" Placement="BottomEdgeAlignedRight" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <ToggleButton Height="28" Width="32" Padding="0" IsTabStop="False" IsChecked="{x:Bind ViewModel.WordWrap, Mode=TwoWay}" x:Uid="Viewer_Wrap">
          <FontIcon Glyph="&#xE751;" FontSize="14" />
        </ToggleButton>
      </StackPanel>
      <Grid x:Name="CaptionPadding" Grid.Column="5" Width="0" />
    </Grid>

    <!-- Text -->
    <TextBox x:Name="TextView" Grid.Row="1" Margin="8,0,8,0" IsReadOnly="True" AcceptsReturn="True" IsSpellCheckEnabled="False"
             FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="10,8" CornerRadius="8"
             Text="{x:Bind ViewModel.Text, Mode=OneWay}"
             TextWrapping="{x:Bind ui:Ui.Wrap(ViewModel.WordWrap), Mode=OneWay}"
             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
             Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsText), Mode=OneWay}" />

    <!-- Hex: one page of rows (as many as fit) and our own scroll bar over the row offset, so a 3 GB file
         costs one 16-byte read per visible row. Keys and the wheel move the offset in code-behind. -->
    <Grid x:Name="HexHost" Grid.Row="1" Margin="8,0,8,0" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
          SizeChanged="OnHexSizeChanged" PointerWheelChanged="OnHexWheel"
          Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsHex), Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ItemsRepeater x:Name="HexRows" Margin="10,6,0,6" ItemsSource="{x:Bind ViewModel.HexPage, Mode=OneWay}">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Vertical" Spacing="0" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{x:Bind}" Height="20" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
      <ScrollBar x:Name="HexScroll" Grid.Column="1" Orientation="Vertical" IndicatorMode="MouseIndicator" Minimum="0" SmallChange="1"
                 Maximum="{x:Bind ui:Ui.ToDouble(ViewModel.HexMaxTop), Mode=OneWay}" Value="{x:Bind ui:Ui.ToDouble(ViewModel.HexTop), Mode=OneWay}"
                 ViewportSize="{x:Bind ui:Ui.ToDouble(ViewModel.HexVisibleLines), Mode=OneWay}" LargeChange="{x:Bind ui:Ui.ToDouble(ViewModel.HexVisibleLines), Mode=OneWay}"
                 Scroll="OnHexScroll" />
    </Grid>

    <!-- Image: fits the window, Ctrl+wheel zooms -->
    <ScrollViewer Grid.Row="1" Margin="8,0,8,0" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="16"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"
                  Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsImage), Mode=OneWay}">
      <Image x:Name="ImageView" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </ScrollViewer>

    <!-- Footer: size, encoding, note; errors as an info bar -->
    <Grid Grid.Row="2" Padding="12,6,12,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      <ProgressRing Grid.Column="1" Width="14" Height="14" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
    <InfoBar Grid.Row="1" VerticalAlignment="Top" Margin="8,8" Severity="Error" IsClosable="False"
             IsOpen="{x:Bind ui:Ui.NotNull(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
  </Grid>
</Window>
