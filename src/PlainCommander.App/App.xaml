      <Color x:Key="SystemAccentColorDark2">#FF0E7490</Color>
      <Color x:Key="SystemAccentColorDark3">#FF155E75</Color>
      <FontFamily x:Key="PanelFont">Segoe UI Variable Text, Segoe UI</FontFamily>

      <!-- Splitter between the panels: an 8 px transparent grab area with a short grip that lights up on hover -->
      <Style TargetType="controls:PanelSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:PanelSplitter">
              <Grid Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Grip.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="Grip.Height" Value="48" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Grip.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="Grip.Height" Value="48" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Rectangle x:Name="Grip" Width="2" Height="28" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
